<Project>
  <!--
    Shared by DiagKit.exe, Uninstall.exe and setup.exe.
    All build output goes to .build\ at the repository root instead of bin\ and obj\ folders inside every
    project. The finished setup.exe is copied to Release\ (see Setup\Setup.csproj).
  -->
  <PropertyGroup>
    <Version>1.1.3</Version>
    <Product>DiagKit</Product>
    <Copyright>Copyright (C) 2026 CrimsonMac</Copyright>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory).build\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
