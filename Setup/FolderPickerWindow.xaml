<Window x:Class="DiagKit.Setup.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:DiagKit.Controls"
        xmlns:local="clr-namespace:DiagKit.Setup"
        Title="Choose where to put the kit" Width="820" Height="580" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource Font.Body}" FontSize="13.5" UseLayoutRounding="True">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Text="Where should the kit go?" Style="{StaticResource Text.Section}" Margin="0" />
            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                       Text="Usually the USB stick itself. Open a folder, or click one to select it; you can make a new folder here too." />
        </StackPanel>

        <!-- Path bar -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,12">
            <Button DockPanel.Dock="Left" Style="{StaticResource Button.Icon}" Content="&#xE74A;" Command="{Binding UpCommand}"
                    Width="32" Height="32" Margin="0,0,6,0" ToolTip="Up one folder (Backspace)" AutomationProperties.Name="Up one folder" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding NewFolderCommand}" Margin="8,0,0,0" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Glyph}" Text="&#xE8F4;" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="New folder" />
                </StackPanel>
            </Button>
            <TextBox x:Name="PathBox" Style="{StaticResource Field}" Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Folder path">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding GoCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <!-- Drives -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Drives" Style="{StaticResource Text.Faint}" FontWeight="SemiBold" Margin="10,6,0,6" />
                <ListBox Style="{StaticResource List}" ItemsSource="{Binding Places}" SelectedItem="{Binding SelectedPlace, Mode=TwoWay}"
                         AutomationProperties.Name="Drives">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PlaceItem}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Glyph}" Text="{Binding Glyph}" FontSize="16"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Free}" Style="{StaticResource Text.Faint}" FontSize="11.5" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Folders -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Padding="6">
            <DockPanel>
                <!-- New folder row -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Raised}" CornerRadius="5" Padding="10,8" Margin="0,0,0,6"
                        Visibility="{Binding IsCreating, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Glyph}" Text="&#xE8F4;" FontSize="16"
                                       Foreground="{DynamicResource Accent}" Margin="0,0,10,0" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Cancel" Command="{Binding CancelCreateCommand}" Margin="4,0,0,0" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Create" Command="{Binding CreateCommand}" Padding="14,6" Margin="8,0,0,0" />
                            <TextBox x:Name="NewFolderBox" Style="{StaticResource Field}" Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="New folder name">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CreateCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding CancelCreateCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <TextBlock Text="{Binding NewFolderError}" Foreground="{DynamicResource Led.Critical}" FontSize="12.5" Margin="26,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding NewFolderError, Converter={StaticResource NotEmptyToVis}}" />
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Style="{StaticResource Text.Muted}" Margin="10,8"
                           Visibility="{Binding Error, Converter={StaticResource NotEmptyToVis}}" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Faint}" Margin="10,8"
                           Text="No folders here. Use this one, or make a new folder for the kit to go in."
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <ListBox x:Name="FolderList" Style="{StaticResource List}" ItemsSource="{Binding Folders}"
                         SelectedItem="{Binding SelectedFolder, Mode=TwoWay}" AutomationProperties.Name="Folders"
                         MouseDoubleClick="FolderList_MouseDoubleClick" KeyDown="FolderList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:FolderItem}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Glyph}" Text="{Binding Glyph}" FontSize="15"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,10,0" />
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{DynamicResource AccentSoft}"
                                        Visibility="{Binding IsKit, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="DiagKit kit" FontSize="11.5" Foreground="{DynamicResource Text}" />
                                </Border>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Where the kit will go -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="14,10" CornerRadius="6" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource AccentLine}" BorderThickness="1">
            <DockPanel>
                <ctl:Led DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top">
                    <ctl:Led.Style>
                        <Style TargetType="ctl:Led" BasedOn="{StaticResource {x:Type ctl:Led}}">
                            <Setter Property="State" Value="Ok" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewIsUpdate}" Value="True">
                                    <Setter Property="State" Value="Info" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ctl:Led.Style>
                </ctl:Led>
                <StackPanel>
                    <TextBlock Text="{Binding ChosenText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PreviewText}" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource Button.Secondary}" Content="Cancel" IsCancel="True" />
            <Button Style="{StaticResource Button.Primary}" Content="Use this folder" Margin="8,0,0,0" IsDefault="True"
                    IsEnabled="{Binding CanChoose}" Click="Use_Click" />
        </StackPanel>
    </Grid>
</Window>
