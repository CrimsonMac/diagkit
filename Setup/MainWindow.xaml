<Window x:Class="DiagKit.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:DiagKit.Controls"
        xmlns:local="clr-namespace:DiagKit.Setup"
        Title="{Binding Title}" Width="900" Height="720" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource Font.Body}" FontSize="13.5" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Progress row: LED, name and the latest status line. -->
        <DataTemplate x:Key="ProgressRow" DataType="{x:Type local:ToolRowViewModel}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ctl:Led State="{Binding Led}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Text.Muted}" FontSize="12.5" Margin="0,1,0,0" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Style="{StaticResource Text.Lede}" Margin="0,6,0,0" FontSize="13.5"
                       Text="A portable diagnostics kit for a USB stick: DiagKit plus the tools you tick below. Every download is checked against its publisher's hash or signature before it goes into the kit." />
        </StackPanel>

        <!-- Choose -->
        <ScrollViewer Grid.Row="1" Margin="0,18,-12,0" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsChoosing, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding BrowseCommand}" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Glyph}" Text="&#xE838;" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Change…" />
                                </StackPanel>
                            </Button>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Location" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TargetText}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Drives}" Margin="0,12,0,0" Focusable="False"
                                      Visibility="{Binding HasDrives, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DriveChoice}">
                                    <Button Style="{StaticResource Button.Ghost}" Margin="0,0,8,0" Padding="10,5"
                                            Command="{Binding DataContext.UseDriveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Root}" BorderBrush="{DynamicResource Line}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Glyph}" Text="&#xE88E;" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Text}" />
                                            <TextBlock Text="{Binding Free}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,22,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Ghost}" Content="All" Command="{Binding SelectAllCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="None" Command="{Binding SelectNoneCommand}" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Tools" Style="{StaticResource Text.Section}" Margin="0" />
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ToolGroupRows}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Faint}" FontWeight="SemiBold" Margin="0,14,0,8" />
                                <ItemsControl ItemsSource="{Binding Tools}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:ToolRowViewModel}">
                                            <DockPanel Margin="0,0,16,10">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Text.Faint}" VerticalAlignment="Center" />
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanChange}">
                                                    <TextBlock>
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                        <Run Text="{Binding Note, Mode=OneWay}" Foreground="{DynamicResource Faint}" FontSize="12" />
                                                    </TextBlock>
                                                </CheckBox>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <CheckBox IsChecked="{Binding AddToStartMenu, Mode=TwoWay}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Add DiagKit to the Start menu on this PC" />
                        <TextBlock Style="{StaticResource Text.Faint}" Margin="0,2,0,0"
                                   Text="So searching for DiagKit in Windows finds it. Best for a kit that stays on this PC; Uninstall removes the shortcut." />
                    </StackPanel>
                </CheckBox>
                <CheckBox Content="Download every tool again, even when it is up to date" IsChecked="{Binding Redownload, Mode=TwoWay}" Margin="0,10,0,4" />
            </StackPanel>
        </ScrollViewer>

        <!-- Working / done -->
        <DockPanel Grid.Row="1" Margin="0,20,0,0" Visibility="{Binding IsChoosing, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}">
                    <ctl:Led State="Busy" Margin="0,0,10,0" />
                    <TextBlock Text="Setting up the kit…" Style="{StaticResource Text.Section}" Margin="0" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ctl:Led State="{Binding ResultLed}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource Text.Section}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource Text.Muted}" Margin="26,6,0,0" FontSize="13" />
                </StackPanel>
            </StackPanel>
            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Log}" Margin="0,10,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Faint}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Card}" Padding="16,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ToolRowViewModel}">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProgressRow}" Focusable="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="{Binding Activity}" Style="{StaticResource Text.Faint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" Margin="0,0,16,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Command="{Binding CloseCommand}" IsCancel="True"
                        Visibility="{Binding IsChoosing, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource Button.Primary}" Content="Install" Command="{Binding InstallCommand}" Margin="8,0,0,0" IsDefault="True"
                        Visibility="{Binding IsChoosing, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource Button.Secondary}" Content="Open folder" Command="{Binding OpenFolderCommand}"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource Button.Secondary}" Content="Start DiagKit" Command="{Binding OpenKitCommand}" Margin="8,0,0,0"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource Button.Primary}" Content="Close" Command="{Binding CloseCommand}" Margin="8,0,0,0"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
