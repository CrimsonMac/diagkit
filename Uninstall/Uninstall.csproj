<Project Sdk="Microsoft.NET.Sdk">

  <!-- Uninstall.exe: removes what DiagKit put on this PC and, optionally, the kit itself. Lives in the kit root. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DiagKit.Uninstall</RootNamespace>
    <AssemblyName>Uninstall</AssemblyName>
    <AssemblyTitle>Uninstall DiagKit</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\App\Assets\app.ico</ApplicationIcon>
    <StartupObject>DiagKit.Uninstall.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="..\Shared\UI\Theme.xaml" Link="Themes\Theme.xaml" />
    <Page Include="..\Shared\UI\Palette.*.xaml" Link="Themes\%(Filename)%(Extension)" />
    <Resource Include="..\App\Assets\app.ico" Link="Assets\app.ico" />
  </ItemGroup>

</Project>
