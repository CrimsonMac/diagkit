<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET Framework 4.8 is part of Windows 10 (1903+) and Windows 11, so DiagKit.exe needs no bundled runtime:
    the whole app is one exe of a few MB instead of 150 MB, starts from the framework's precompiled WPF, and
    leaves nothing behind on the PC (a self-contained .NET single-file app extracts itself to %TEMP%).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>DiagKit</RootNamespace>
    <AssemblyName>DiagKit</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main wraps WPF startup so early failures are logged instead of silently killing the process. -->
    <StartupObject>DiagKit.Program</StartupObject>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- No DiagKit.exe.config: binding redirects are handled by the embedded-assembly resolver in Program. -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>

    <!-- Lets the project restore/build on non-Windows CI; harmless on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Text.Json" Version="10.0.3" />
    <!-- Compile-time only: attributes and types newer C# features need on .NET Framework (init, Index/Range, ...). -->
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="..\Shared\UI\Theme.xaml" Link="Themes\Theme.xaml" />
    <Page Include="..\Shared\UI\Palette.*.xaml" Link="Themes\%(Filename)%(Extension)" />
    <EmbeddedResource Include="tools.default.json" LogicalName="DiagKit.tools.default.json" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!--
    Single exe: every referenced library (LibreHardwareMonitor, System.Text.Json, ...) is embedded as a resource
    and loaded from memory by Program's assembly resolver, so the kit folder holds DiagKit.exe and nothing else.
  -->
  <Target Name="EmbedReferencedAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_DiagKitDeps Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' And '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == ''" />
      <EmbeddedResource Include="@(_DiagKitDeps)" LogicalName="deps/%(_DiagKitDeps.Filename)%(_DiagKitDeps.Extension)" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
  </Target>

</Project>
