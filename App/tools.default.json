{
  // DiagKit tool manifest. Edit freely; DiagKit re-reads it on "Rescan".
  //   folder          subfolder of Tools\ to search (recursively, 3 levels)
  //   executables     file name patterns, tried in order (* and ? allowed)
  //   arguments       passed on every launch
  //   registryTraces  keys the tool writes: deleted after it exits if it created them, restored if they existed before
  //   registryParents same, but only deleted when left empty
  //   services        driver services the tool installs (* allowed): removed after it exits, only if that run created them
  //   files           files the tool leaves outside its folder (%TEMP%\x*.sys): deleted after it exits if that run created them
  //   hidden          used by the health check only, not shown as a tile
  "version": 3,
  "tools": [
    {
      "id": "hwinfo",
      "name": "HWiNFO64",
      "category": "Hardware",
      "description": "Full hardware inventory and live sensors: temperatures, clocks, voltages, WHEA error counts.",
      "folder": "HWiNFO64",
      "executables": [ "HWiNFO64.exe" ],
      "services": [ "HWiNFO*" ],
      "homepage": "https://www.hwinfo.com/download/"
    },
    {
      "id": "cpuz",
      "name": "CPU-Z",
      "category": "Hardware",
      "description": "CPU, motherboard and memory details, including RAM timings and SPD data per stick.",
      "folder": "CPU-Z",
      "executables": [ "cpuz_x64.exe", "cpuz*.exe" ],
      "services": [ "cpuz*" ],
      "homepage": "https://www.cpuid.com/softwares/cpu-z.html"
    },
    {
      "id": "gpuz",
      "name": "GPU-Z",
      "category": "Hardware",
      "description": "Graphics card identity, BIOS, bus interface and sensors. Good for spotting fake or rebadged cards.",
      "folder": "GPU-Z",
      "executables": [ "GPU-Z*.exe" ],
      "registryTraces": [ "HKCU\\Software\\techPowerUp\\GPU-Z" ],
      "registryParents": [ "HKCU\\Software\\techPowerUp" ],
      "services": [ "GPU-Z*", "GPUZ*" ],
      "files": [ "%TEMP%\\GPU-Z*.sys", "%SystemRoot%\\Temp\\GPU-Z*.sys" ],
      "homepage": "https://www.techpowerup.com/gpuz/"
    },
    {
      "id": "batteryinfoview",
      "name": "BatteryInfoView",
      "category": "Hardware",
      "description": "Laptop battery wear: design versus full-charge capacity, charge cycles, and the current charge or drain rate.",
      "folder": "BatteryInfoView",
      "executables": [ "BatteryInfoView.exe" ],
      "registryTraces": [ "HKCU\\Software\\NirSoft\\BatteryInfoView" ],
      "registryParents": [ "HKCU\\Software\\NirSoft" ],
      "homepage": "https://www.nirsoft.net/utils/battery_information_view.html"
    },
    {
      "id": "crystaldiskinfo",
      "name": "CrystalDiskInfo",
      "category": "Storage",
      "description": "SMART health, temperature and power-on hours for every drive.",
      "folder": "CrystalDiskInfo",
      "executables": [ "DiskInfo64.exe", "DiskInfo*.exe" ],
      "homepage": "https://crystalmark.info/en/software/crystaldiskinfo/"
    },
    {
      "id": "crystaldiskmark",
      "name": "CrystalDiskMark",
      "category": "Storage",
      "description": "Sequential and random read/write benchmark. Catches drives running far below their rated speed.",
      "folder": "CrystalDiskMark",
      "executables": [ "DiskMark64.exe", "DiskMark*.exe" ],
      "homepage": "https://crystalmark.info/en/software/crystaldiskmark/"
    },
    {
      "id": "wiztree",
      "name": "WizTree",
      "category": "Storage",
      "description": "Shows what is filling a drive, in seconds, by reading the NTFS file table directly.",
      "folder": "WizTree",
      "executables": [ "WizTree64.exe", "WizTree.exe" ],
      "homepage": "https://diskanalyzer.com/download"
    },
    {
      "id": "everything",
      "name": "Everything",
      "category": "Storage",
      "description": "Instant file name search across all NTFS drives. Handy for finding logs and dumps.",
      "folder": "Everything",
      "executables": [ "Everything64.exe", "Everything.exe" ],
      "homepage": "https://www.voidtools.com/downloads/"
    },
    {
      "id": "testmem5",
      "name": "TestMem5",
      "category": "Memory and stability",
      "description": "RAM stress test inside Windows. Starts with anta777's Extreme config; load absolut@anta777.cfg from bin for a longer run.",
      "folder": "TestMem5",
      "executables": [ "TM5.exe" ]
    },
    {
      "id": "prime95",
      "name": "Prime95",
      "category": "Memory and stability",
      "description": "The classic CPU and memory torture test. Choose \"Just stress testing\"; errors or a crash mean the system is unstable.",
      "folder": "Prime95",
      "executables": [ "prime95.exe" ],
      "homepage": "https://www.mersenne.org/download/"
    },
    {
      "id": "bluescreenview",
      "name": "BlueScreenView",
      "category": "Crashes and startup",
      "description": "Reads crash dumps and names the driver each blue screen points at.",
      "folder": "BlueScreenView",
      "executables": [ "BlueScreenView.exe" ],
      "registryTraces": [ "HKCU\\Software\\NirSoft\\BlueScreenView" ],
      "registryParents": [ "HKCU\\Software\\NirSoft" ],
      "homepage": "https://www.nirsoft.net/utils/blue_screen_view.html"
    },
    {
      "id": "turnedontimesview",
      "name": "TurnedOnTimesView",
      "category": "Crashes and startup",
      "description": "Timeline of every startup and shutdown, flagging the ones that were sudden power losses or crashes.",
      "folder": "TurnedOnTimesView",
      "executables": [ "TurnedOnTimesView.exe" ],
      "registryTraces": [ "HKCU\\Software\\NirSoft\\TurnedOnTimesView" ],
      "registryParents": [ "HKCU\\Software\\NirSoft" ],
      "homepage": "https://www.nirsoft.net/utils/computer_turned_on_times.html"
    },
    {
      "id": "appcrashview",
      "name": "AppCrashView",
      "category": "Crashes and startup",
      "description": "Every program crash Windows Error Reporting recorded, with the faulting module and exception code.",
      "folder": "AppCrashView",
      "executables": [ "AppCrashView.exe" ],
      "registryTraces": [ "HKCU\\Software\\NirSoft\\AppCrashView" ],
      "registryParents": [ "HKCU\\Software\\NirSoft" ],
      "homepage": "https://www.nirsoft.net/utils/app_crash_view.html"
    },
    {
      "id": "autoruns",
      "name": "Autoruns",
      "category": "Crashes and startup",
      "description": "Every startup entry, service, driver and scheduled task, with signature checks.",
      "folder": "Autoruns",
      "executables": [ "Autoruns64.exe", "Autoruns.exe" ],
      "arguments": "-accepteula",
      "registryTraces": [ "HKCU\\Software\\Sysinternals\\Autoruns" ],
      "registryParents": [ "HKCU\\Software\\Sysinternals" ],
      "homepage": "https://learn.microsoft.com/sysinternals/downloads/autoruns"
    },
    {
      "id": "procexp",
      "name": "Process Explorer",
      "category": "Processes and memory",
      "description": "Task Manager done properly: process tree, handles, DLLs, and VirusTotal lookups.",
      "folder": "ProcessExplorer",
      "executables": [ "procexp64.exe", "procexp.exe" ],
      "arguments": "-accepteula",
      "registryTraces": [ "HKCU\\Software\\Sysinternals\\Process Explorer" ],
      "registryParents": [ "HKCU\\Software\\Sysinternals" ],
      "services": [ "PROCEXP*" ],
      "homepage": "https://learn.microsoft.com/sysinternals/downloads/process-explorer"
    },
    {
      "id": "procmon",
      "name": "Process Monitor",
      "category": "Processes and memory",
      "description": "Live log of file, registry and process activity. Shows what a misbehaving program is actually doing.",
      "folder": "ProcessMonitor",
      "executables": [ "Procmon64.exe", "Procmon.exe" ],
      "arguments": "-accepteula",
      "registryTraces": [ "HKCU\\Software\\Sysinternals\\Process Monitor" ],
      "registryParents": [ "HKCU\\Software\\Sysinternals" ],
      "services": [ "PROCMON*" ],
      "homepage": "https://learn.microsoft.com/sysinternals/downloads/procmon"
    },
    {
      "id": "rammap",
      "name": "RAMMap",
      "category": "Processes and memory",
      "description": "Where physical memory actually went: standby list, driver allocations, mapped files.",
      "folder": "RAMMap",
      "executables": [ "RAMMap64.exe", "RAMMap.exe" ],
      "arguments": "-accepteula",
      "registryTraces": [ "HKCU\\Software\\Sysinternals\\RAMMap" ],
      "registryParents": [ "HKCU\\Software\\Sysinternals" ],
      "services": [ "RAMMap*" ],
      "homepage": "https://learn.microsoft.com/sysinternals/downloads/rammap"
    },
    {
      "id": "usbdeview",
      "name": "USBDeview",
      "category": "Devices and network",
      "description": "Every USB device this PC has seen, connected or not. Useful for flaky ports and devices that keep disconnecting.",
      "folder": "USBDeview",
      "executables": [ "USBDeview.exe" ],
      "registryTraces": [ "HKCU\\Software\\NirSoft\\USBDeview" ],
      "registryParents": [ "HKCU\\Software\\NirSoft" ],
      "homepage": "https://www.nirsoft.net/utils/usb_devices_view.html"
    },
    {
      "id": "tcpview",
      "name": "TCPView",
      "category": "Devices and network",
      "description": "Every open network connection and the program behind it. Spots unexpected traffic at a glance.",
      "folder": "TCPView",
      "executables": [ "tcpview64.exe", "tcpview.exe" ],
      "arguments": "-accepteula",
      "registryTraces": [ "HKCU\\Software\\Sysinternals\\TCPView" ],
      "registryParents": [ "HKCU\\Software\\Sysinternals" ],
      "homepage": "https://learn.microsoft.com/sysinternals/downloads/tcpview"
    },
    {
      "id": "pawnio",
      "name": "PawnIO driver setup",
      "category": "Health check components",
      "description": "Signed driver for CPU temperatures. The health check offers to install it when it is missing.",
      "folder": "PawnIO",
      "executables": [ "PawnIO_setup.exe", "PawnIO*setup*.exe", "PawnIO*.exe" ],
      "hidden": true,
      "homepage": "https://pawnio.eu/"
    },
    {
      "id": "smartctl",
      "name": "smartctl",
      "category": "Health check components",
      "description": "Reads SMART data for the health check.",
      "folder": "smartmontools",
      "executables": [ "smartctl.exe" ],
      "hidden": true,
      "homepage": "https://www.smartmontools.org/"
    },
    {
      "id": "autorunsc",
      "name": "autorunsc",
      "category": "Health check components",
      "description": "Console Autoruns, used by the health check to list unsigned startup entries.",
      "folder": "Autoruns",
      "executables": [ "autorunsc64.exe", "autorunsc.exe" ],
      "arguments": "-accepteula",
      "registryTraces": [ "HKCU\\Software\\Sysinternals\\Autoruns" ],
      "registryParents": [ "HKCU\\Software\\Sysinternals" ],
      "hidden": true
    }
  ]
}
