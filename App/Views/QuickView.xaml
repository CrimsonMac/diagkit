<UserControl x:Class="DiagKit.Views.QuickView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiagKit.ViewModels"
             xmlns:ctl="clr-namespace:DiagKit.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,26,32,32">
            <TextBlock Text="Quick actions" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Style="{StaticResource Text.Lede}" Margin="0,8,0,0"
                       Text="Check just the part you are after instead of running the whole health check. Each one is saved as a short report under Reports." />

            <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="6" Background="{DynamicResource Surface}" MaxWidth="800" HorizontalAlignment="Left"
                    BorderBrush="{DynamicResource Led.Warning}" BorderThickness="1"
                    Visibility="{Binding Health.IsElevated, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <DockPanel>
                    <ctl:Led State="Warning" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <TextBlock TextWrapping="Wrap"
                               Text="DiagKit is not running as administrator, so drive health, crash dumps and sensors will be incomplete. Close it and start it again with 'Run as administrator'." />
                </DockPanel>
            </Border>

            <CheckBox IsChecked="{Binding InstallPawnIo}" Margin="0,16,0,0" MaxWidth="800" HorizontalAlignment="Left"
                      Visibility="{Binding Health.CanInstallPawnIo, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Install the CPU temperature driver first" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Text="Only for actions that read temperatures. PawnIO is a signed driver that is not on this PC yet; it stays installed and can be removed in Settings > Apps." />
                </StackPanel>
            </CheckBox>

            <!-- Quick actions -->
            <ItemsControl ItemsSource="{Binding Actions}" Margin="0,20,0,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctl:TileGrid MinTileWidth="290" TileHeight="132" Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:QuickAction}">
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <DockPanel>
                                <!-- Run buttons -->
                                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Runs}" Focusable="False" HorizontalAlignment="Left" Margin="34,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:QuickRun}">
                                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding Command}" Padding="12,5" Margin="0,0,8,0"
                                                    AutomationProperties.Name="{Binding Label}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Text.Glyph}" Text="&#xE768;" FontSize="10" Margin="0,0,7,0" />
                                                    <TextBlock Text="{Binding Label}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Glyph}" Text="{Binding Glyph}" FontSize="20"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,14,0" Width="20" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Name}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" MaxHeight="36" ToolTip="{Binding Description}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Custom diagnosis -->
            <StackPanel Margin="0,34,0,0" MaxWidth="900" HorizontalAlignment="Left">
                <DockPanel Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource Button.Ghost}" Content="All" Command="{Binding SelectAllCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="None" Command="{Binding SelectNoneCommand}" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Custom diagnosis" Style="{StaticResource Text.Section}" Margin="0" />
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                                   Text="Tick the checks you want and run them together as one report. The system overview is always included, so the report says which PC it is about." />
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Checks}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CheckOption}">
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,20,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Faint}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Rule}" Margin="0,4,0,18" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="CPU load test" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Text.Faint}" Margin="0,2,0,0"
                                           Text="Every core at full load to catch overheating and throttling. Temperatures are read along with it." />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    CornerRadius="5" Padding="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="CustomStress" Content="Off"
                                                 IsChecked="{Binding CustomStress, Converter={StaticResource EqualsParam}, ConverterParameter=0}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="CustomStress" Content="30 s"
                                                 IsChecked="{Binding CustomStress, Converter={StaticResource EqualsParam}, ConverterParameter=30}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="CustomStress" Content="2 min"
                                                 IsChecked="{Binding CustomStress, Converter={StaticResource EqualsParam}, ConverterParameter=120}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Rule}" Margin="0,18" />

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding RunCustomCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Glyph}" Text="&#xE768;" FontSize="12" Margin="0,0,9,0" />
                                    <TextBlock Text="Run custom check" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding CustomSummary}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
