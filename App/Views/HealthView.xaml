<UserControl x:Class="DiagKit.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiagKit.ViewModels"
             xmlns:views="clr-namespace:DiagKit.Views"
             xmlns:report="clr-namespace:DiagKit.Report"
             xmlns:ctl="clr-namespace:DiagKit.Controls">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ============================== Setup -->
        <ScrollViewer Visibility="{Binding IsSetup, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="32,26,32,32" MaxWidth="800" HorizontalAlignment="Left">
                <TextBlock Text="Health check" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Style="{StaticResource Text.Lede}" Margin="0,8,0,0">
                    <Run Text="Reads drive health," /> <Run Text="{Binding EventWindowDays, Mode=OneTime}" /> <Run Text="days of crash and hardware-error logs, temperatures and startup entries, then explains what it found and what to do about it." />
                </TextBlock>

                <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="CPU load test" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                                           Text="Loads every core to catch overheating and throttling. Fans will get loud while it runs." />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    CornerRadius="5" Padding="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Stress" Content="Off" IsChecked="{Binding StressOff, Mode=TwoWay}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Stress" Content="30 s" IsChecked="{Binding Stress30, Mode=TwoWay}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Stress" Content="2 min" IsChecked="{Binding Stress120, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Rule}" Margin="0,18" />

                        <CheckBox IsChecked="{Binding IncludeStartup}">
                            <StackPanel>
                                <TextBlock Text="Scan startup entries" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                                           Text="Lists unsigned and broken programs that start with Windows. Checking signatures adds 20 to 60 seconds." />
                            </StackPanel>
                        </CheckBox>

                        <StackPanel Visibility="{Binding CanInstallPawnIo, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource Rule}" Margin="0,18" />
                            <CheckBox IsChecked="{Binding InstallPawnIo}">
                                <StackPanel>
                                    <TextBlock Text="Install the CPU temperature driver" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Text="CPU temperatures need PawnIO, a signed driver that is not installed on this PC. It stays installed afterwards and can be removed in Settings > Apps." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>

                        <Border Style="{StaticResource Rule}" Margin="0,18" />

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding RunCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Glyph}" Text="&#xE768;" FontSize="12" Margin="0,0,9,0" />
                                    <TextBlock Text="Run health check" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding EstimateText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="6" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Led.Warning}" BorderThickness="1"
                        Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <DockPanel>
                        <ctl:Led State="Warning" Margin="0,0,10,0" VerticalAlignment="Top" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="DiagKit is not running as administrator, so drive health, crash dumps and sensors will be incomplete. Close it and start it again with 'Run as administrator'." />
                    </DockPanel>
                </Border>

                <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-10,12,0,0" Command="{Binding ShowLastReportCommand}"
                        Visibility="{Binding HasPreviousReport, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="&#xE72B;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Back to the last report" />
                    </StackPanel>
                </Button>

                <TextBlock Text="What the check can use on this PC" Style="{StaticResource Text.Section}" />
                <ItemsControl ItemsSource="{Binding Components}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ComponentItem}">
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ctl:Led State="{Binding Led}" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================== Running -->
        <Grid Margin="32,26,12,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,20,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="&#xE711;" FontSize="11" Margin="0,0,8,0" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{Binding RunTitle}" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Steps}" Margin="0,0,20,24" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type report:CollectorStatus}">
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <ctl:Led State="{Binding Led}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Faint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Text.Muted}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding SecondsText}" FontFamily="{StaticResource Font.Display}"
                                               Foreground="{DynamicResource Faint}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ============================== Results -->
        <ContentControl Content="{Binding Report}" Focusable="False" Visibility="{Binding IsResults, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
