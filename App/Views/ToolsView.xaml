<UserControl x:Class="DiagKit.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiagKit.ViewModels"
             xmlns:ctl="clr-namespace:DiagKit.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <!-- Hovered tiles and their group draw above their neighbours, so an expanded tile overlaps instead of being covered. -->
        <Style x:Key="RaiseOnHover" TargetType="ContentPresenter">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Panel.ZIndex" Value="1" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Panel.ZIndex" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TileContainer" TargetType="ContentPresenter" BasedOn="{StaticResource RaiseOnHover}">
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
        </Style>
        <Style x:Key="GroupContainer" TargetType="ContentPresenter" BasedOn="{StaticResource RaiseOnHover}">
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,26,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,20,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Width="260" Tag="Search tools (Ctrl+F)"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LaunchFirstCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Style="{StaticResource Button.Icon}" Width="34" Height="34" Margin="8,0,0,0" Content="&#xE72C;"
                        Command="{Binding RescanCommand}" ToolTip="Rescan: look again for tools added to the Tools folder" />
                <Button Style="{StaticResource Button.Secondary}" Margin="4,0,0,0" Command="{Binding OpenToolsFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="&#xE838;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Tools folder" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Tools" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <!-- The bottom margin leaves room for a tile in the last row to expand. -->
            <StackPanel Margin="0,0,20,120">
                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" ItemContainerStyle="{StaticResource GroupContainer}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ToolGroupViewModel}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Section}" Margin="0,24,0,12" />
                                <ItemsControl ItemsSource="{Binding Tools}" Focusable="False" ItemContainerStyle="{StaticResource TileContainer}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ctl:TileGrid MinTileWidth="290" TileHeight="96" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ToolViewModel}">
                                            <!-- A Canvas never clips: the tile keeps its grid slot and grows downwards over the next row on hover. -->
                                            <Canvas x:Name="Slot">
                                                <Button x:Name="Tile" Style="{StaticResource Button.Tile}" MinHeight="96"
                                                        Width="{Binding ActualWidth, ElementName=Slot}"
                                                        Command="{Binding LaunchCommand}" AutomationProperties.Name="{Binding Name}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid x:Name="IconSlot" Grid.RowSpan="2" Width="30" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
                                                            <Border CornerRadius="7" Background="{StaticResource Raised}"
                                                                    Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                                <TextBlock Text="{Binding Monogram}" FontFamily="{StaticResource Font.Display}" FontWeight="SemiBold"
                                                                           FontSize="11.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Grid>

                                                        <DockPanel Grid.Column="1">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                        ToolTip="{Binding StatusText}">
                                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Faint}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                                                <ctl:Led State="{Binding Led}" Width="12" Height="12" Padding="3" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Name}" />
                                                        </DockPanel>

                                                        <TextBlock x:Name="Description" Grid.Row="1" Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Text.Muted}"
                                                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18"
                                                                   LineStackingStrategy="BlockLineHeight" />

                                                        <!-- Only shown while the tile is expanded. -->
                                                        <DockPanel x:Name="Details" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Visibility="Collapsed">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE838;" Width="28" Height="28"
                                                                    Margin="8,-4,-6,-4" Command="{Binding OpenFolderCommand}" ToolTip="Open this tool's folder"
                                                                    AutomationProperties.Name="Open folder" />
                                                            <TextBlock Text="{Binding LocationText}" Style="{StaticResource Text.Faint}" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </Grid>
                                                </Button>
                                            </Canvas>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                    <Setter TargetName="IconSlot" Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Description" Property="MaxHeight" Value="{x:Static sys:Double.PositiveInfinity}" />
                                                    <Setter TargetName="Description" Property="TextTrimming" Value="None" />
                                                    <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger SourceName="Tile" Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="Description" Property="MaxHeight" Value="{x:Static sys:Double.PositiveInfinity}" />
                                                    <Setter TargetName="Description" Property="TextTrimming" Value="None" />
                                                    <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,40,0,0" Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No tools match that search" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="Search covers names, descriptions and categories. Press Esc to clear it." />
                </StackPanel>

                <TextBlock Margin="0,40,0,0" Text="Looking for tools…" Style="{StaticResource Text.Muted}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
