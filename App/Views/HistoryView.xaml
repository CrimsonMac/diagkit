<UserControl x:Class="DiagKit.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiagKit.ViewModels"
             xmlns:views="clr-namespace:DiagKit.Views"
             xmlns:ctl="clr-namespace:DiagKit.Controls">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="32,26,12,0" Visibility="{Binding IsListing, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,20,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="&#xE72C;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding OpenReportsFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="&#xE838;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Reports folder" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Reports" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{Binding LocationText}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,20,28">
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReportListingViewModel}">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6"
                                        Margin="0,0,0,8" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ctl:Led State="{Binding Led}" HorizontalAlignment="Left" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Machine}" Style="{StaticResource Text.Name}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding When}" Style="{StaticResource Text.Muted}" />
                                                <TextBlock Text="{Binding Ago}" Style="{StaticResource Text.Faint}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"
                                                   Margin="16,0,20,0" TextWrapping="NoWrap" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenCommand}" Content="Open" Padding="16,6" />
                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE8A7;" Command="{Binding OpenHtmlCommand}"
                                                    ToolTip="Open the HTML report in your browser" Margin="6,0,0,0" />
                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE838;" Command="{Binding OpenFolderCommand}"
                                                    ToolTip="Open the report folder" />
                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" Command="{Binding DeleteCommand}"
                                                    ToolTip="Delete this report" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,30,0,0" MaxWidth="520" HorizontalAlignment="Left"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No reports yet" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="13.5" LineHeight="20"
                                   Text="Every health check saves its report here, so you can reopen it later or send the HTML file to someone." />
                        <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,16,0,0" Content="Go to health check"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Health" />
                    </StackPanel>

                    <TextBlock Text="Reading reports…" Style="{StaticResource Text.Muted}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- A saved report, opened from the list -->
        <ContentControl Content="{Binding CurrentReport}" Focusable="False" />
    </Grid>
</UserControl>
