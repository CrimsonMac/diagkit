<Window x:Class="DiagKit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiagKit.ViewModels"
        xmlns:views="clr-namespace:DiagKit.Views"
        xmlns:ctl="clr-namespace:DiagKit.Controls"
        Title="DiagKit" Width="1180" Height="780" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource Font.Body}" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Pages are created only when first shown. -->
        <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
            <views:ToolsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuickViewModel}">
            <views:QuickView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HealthViewModel}">
            <views:HealthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FindCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="Tools" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="Quick" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="Health" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="History" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
        <KeyBinding Key="F5" Command="{Binding RunCheckCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title bar -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource Rail}" />
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <Image Source="Assets/app.ico" Width="18" Height="18" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="DiagKit" FontFamily="{StaticResource Font.Display}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            <Border Style="{StaticResource Chip}" Margin="14,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Glyph}" Text="&#xE977;" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding MachineName}" Foreground="{DynamicResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Margin="6,0,0,0" ToolTip="{Binding ElevationText}" WindowChrome.IsHitTestVisibleInChrome="True">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                        <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Led.Warning}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Raised}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Glyph}" Text="&#xEA18;" FontSize="11" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ElevationText}" FontSize="12" />
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
            <Button x:Name="MaxButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
            <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
        </StackPanel>

        <!-- Navigation rail -->
        <Border Grid.Row="1" Background="{DynamicResource Rail}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                    <RadioButton Style="{StaticResource Rail.Item}" GroupName="Nav" Tag="&#xE90F;" Content="Tools"
                                 IsChecked="{Binding IsToolsPage, Mode=TwoWay}" ToolTip="Tools (Ctrl+1)" />
                    <RadioButton Style="{StaticResource Rail.Item}" GroupName="Nav" Tag="&#xE945;" Content="Quick"
                                 IsChecked="{Binding IsQuickPage, Mode=TwoWay}" ToolTip="Quick actions and custom diagnosis (Ctrl+2)" />
                    <RadioButton Style="{StaticResource Rail.Item}" GroupName="Nav" Tag="&#xE95E;" Content="Health"
                                 IsChecked="{Binding IsHealthPage, Mode=TwoWay}" ToolTip="Full health check (Ctrl+3, F5 runs one)" />
                    <RadioButton Style="{StaticResource Rail.Item}" GroupName="Nav" Tag="&#xE81C;" Content="Reports"
                                 IsChecked="{Binding IsHistoryPage, Mode=TwoWay}" ToolTip="Saved reports (Ctrl+4)" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" Style="{StaticResource Text.Faint}" HorizontalAlignment="Center"
                           Margin="0,0,0,14" />
                <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource Rail.Item}" GroupName="Nav" Tag="&#xE713;" Content="Settings"
                             IsChecked="{Binding IsSettingsPage, Mode=TwoWay}" ToolTip="Settings (Ctrl+,)" Margin="0,0,0,4" />
                <Button DockPanel.Dock="Bottom" Style="{StaticResource Button.Icon}" Content="&#xE74D;" Width="40" Height="36" Margin="0,0,0,6"
                        HorizontalAlignment="Center" Command="{Binding UninstallCommand}" AutomationProperties.Name="Uninstall"
                        Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}"
                        ToolTip="Clean this PC or remove DiagKit (opens Uninstall.exe)" />
            </DockPanel>
        </Border>

        <!-- Current page -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0"
                Background="{DynamicResource Bg}" ClipToBounds="True">
            <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
        </Border>

        <!-- Notice -->
        <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" MaxWidth="540"
                Background="{DynamicResource Raised}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="6"
                Padding="14,10,6,10" Visibility="{Binding IsNoticeVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ctl:Led State="{Binding NoticeLed}" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="19" />
                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="10" Width="26" Height="26"
                        Margin="8,-3,0,0" VerticalAlignment="Top" Command="{Binding DismissNoticeCommand}" ToolTip="Dismiss" />
            </Grid>
        </Border>
    </Grid>
</Window>
